# Configuración del servidor SIGPIAR
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://sigpiar:sigpiar@localhost:5432/sigpiar

# Clave para firmar los tokens JWT (cámbiala en producción)
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES=8h

# Origen permitido para el frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173
